   "source": [
    "from sklearn.ensemble import RandomForestClassifier\n",
    "\n",
    "random_forest_model = RandomForestClassifier(\n",
    "    n_estimators=100,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "random_forest_model.fit(X_train, y_train)\n",
    "\n",
    "print(\"Random Forest model trained successfully!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "279cbd5d-0e96-4b72-8e26-8afc7180915b",
   "metadata": {},
   "outputs": [],
   "source": [
    "preprocessing_data = {\n",
    "    \"features\": X_train.columns.tolist(),\n",
    "    \"medians\": {\n",
    "        \"Monthly_Charges\": X_train[\"Monthly_Charges\"].median(),\n",
    "        \"Usage_Hours\": X_train[\"Usage_Hours\"].median(),\n",
    "        \"Customer_Satisfaction\": X_train[\"Customer_Satisfaction\"].median()\n",
    "    }\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "3dc52cf4-0455-4291-8de5-fd85eccd5f0b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[0.97 0.39 0.05 0.64 0.96 0.92 0.97 0.4  0.97 0.  ]\n"
     ]
    }
   ],
   "source": [
    "churn_probability = random_forest_model.predict_proba(X)[:, 1]\n",
    "\n",
    "print(churn_probability[:10])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "5f308adf-f62e-4b35-962a-4b38b99abe14",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_risk_level(probability):\n",
    "    if probability <= 0.30:\n",
    "        return \"Low\"\n",
    "    elif probability <= 0.70:\n",
    "        return \"Medium\"\n",
    "    else:\n",
    "        return \"High\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "10e87fd2-ffa1-4997-854c-93176291c3c9",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_risk = df.copy()\n",
    "\n",
    "df_risk[\"Churn_Probability\"] = churn_probability\n",
    "\n",
    "df_risk[\"Risk_Level\"] = df_risk[\"Churn_Probability\"].apply(\n",
    "    get_risk_level\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "6dc609b5-8a10-47a2-ad68-223bc06cfe6c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Customer_ID  Churn_Probability Risk_Level\n",
      "0   CUST10001               0.97       High\n",
      "1   CUST10002               0.39     Medium\n",
